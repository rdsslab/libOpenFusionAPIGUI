{
	"name": "@rdsslab/libopenfusionapigui",
	"version": "9.5.1",
	"main": "./dist/index.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rdsslab/libOpenFusionAPIGUI.git"
	},
	"keywords": [
		"svelte",
		"javascript",
		"component",
		"OpenFusionAPI",
		"edwinspire",
		"api"
	],
	"author": "edwinspire",
	"license": "LGPL-3.0",
	"bugs": {
		"url": "https://github.com/rdsslab/libOpenFusionAPIGUI.git/issues"
	},
	"homepage": "https://github.com/rdsslab/libOpenFusionAPIGUI.git#readme",
	"description": "GUI for OpenFusionAPI",
	"scripts": {
		"dev": "vite dev",
		"dev_proxy": "vite dev --host --port 5317 --proxy",
		"build": "node ./set_version.js && vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"reinstall": "rm -rf node_modules package-lock.json && npm install"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^5.20.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@types/eslint": "8.56.0",
		"eslint": "^9.7.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"globals": "^17.12.0",
		"prettier": "^3.3.2",
		"prettier-plugin-svelte": "^3.2.6",
		"publint": "^0.1.9",
		"svelte-check": "^4.0.0",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^5.4.11"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.0.0",
		"@rdsslab/svelte-components": "https://github.com/rdsslab/svelte-components.git",
		"@rdsslab/uFetch": "https://github.com/rdsslab/uFetch.git",
		"bulma": "^1.0.4",
		"luxon": "^3.7.2"
	}
}
